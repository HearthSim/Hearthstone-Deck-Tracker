<UserControl x:Class="Hearthstone_Deck_Tracker.FlyoutControls.Options.Overlay.OverlayRelatedCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:overlay="clr-namespace:Hearthstone_Deck_Tracker.FlyoutControls.Options.Overlay"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="HearthstoneDeckTracker"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500">
    <UserControl.Resources>
        <!-- One template for every related card: nothing here mentions a specific card, which is what
             keeps this page zero-touch when a new related card is added. -->
        <DataTemplate x:Key="RelatedCardRowTemplate" DataType="{x:Type overlay:RelatedCardSettingRow}">
            <!-- The right margin keeps the dropdown off the list's scrollbar. -->
            <Grid Margin="0,3,10,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Height="30" Width="30" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding CardAsset.Asset}">
                            <ImageBrush.Transform>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" CenterX="16" CenterY="11"/>
                            </ImageBrush.Transform>
                        </ImageBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" ToolTip="{Binding CardIdsText}"
                           VerticalAlignment="Center" Margin="8,0,10,0" TextTrimming="CharacterEllipsis"/>

                <ComboBox Grid.Column="2" Width="110" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={x:Static overlay:CounterSettingRow.VisibilityOptions}}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding OpponentVisibility, Mode=TwoWay}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </UserControl.Resources>

    <!-- The list is the only thing on this page that scrolls (see IOptionsPageWithOwnScrolling): the
         host does not scroll this page, so the row above the list stays put and the list takes
         whatever height is left. -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{lex:Loc OptionsRelatedCards_Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="{lex:Loc OptionsCounters_ResetAll}"
                    Padding="10,2" Margin="8,0,0,0"
                    Command="{Binding ResetAllCommand}"
                    IsEnabled="{Binding HasAnyOverride}"/>
            <CheckBox DockPanel.Dock="Right" Content="{lex:Loc OptionsRelatedCards_CustomizedOnly}"
                      Margin="8,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding CustomizedOnly}"/>
            <TextBox x:Name="TextBoxFilter"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     controls:TextBoxHelper.Watermark="{lex:Loc OptionsRelatedCards_Filter_Placeholder}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="controls:TextBoxHelper.ClearTextButton" Value="True"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="controls:TextBoxHelper.ClearTextButton" Value="False"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DockPanel>

        <!-- There are hundreds of related cards, so this list is virtualized instead of being laid
             out all at once. That needs a bounded height, which the star row above provides. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RelatedCardRowTemplate}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <DockPanel>
                        <!-- Sized to the list's viewport and padded like the rows, so the headers line up
                             with the dropdowns. The scrollbar always shows, so filtering never shifts them. -->
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="0,0,10,0"
                                Width="{Binding ViewportWidth, ElementName=Scroller}">
                            <TextBlock Width="110" HorizontalAlignment="Right"
                                       Text="{lex:Loc OptionsCounters_Column_Opponent}" Style="{StaticResource ColumnHeaderStyle}"/>
                        </Border>

                        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc OptionsRelatedCards_NoResults}" Margin="0,12,0,0"
                                   Visibility="{Binding NoResultsVisibility}"/>

                        <ScrollViewer x:Name="Scroller" Margin="0,4,0,0" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </DockPanel>
                </ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>
    </Grid>
</UserControl>
