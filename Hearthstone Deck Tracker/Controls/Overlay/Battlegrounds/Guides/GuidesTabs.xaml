<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides.GuidesTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides"
             xmlns:battlegrounds="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds"
             xmlns:minions="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Minions"
             xmlns:comps="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides.Comps"
             xmlns:extensions="clr-namespace:Hearthstone_Deck_Tracker.Utility.Extensions"
             xmlns:heroes="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides.Heroes"
             xmlns:quests="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Battlegrounds.Guides.Quests"
             xmlns:hearthstoneDeckTracker="clr-namespace:Hearthstone_Deck_Tracker"
             xmlns:anim="clr-namespace:Hearthstone_Deck_Tracker.Utility.Animations"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="HearthstoneDeckTracker"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d"
             Width="249"
             d:DesignHeight="249" d:DesignWidth="249"
             d:DataContext="{d:DesignInstance local:BattlegroundsGuidesTabsViewModel}"
             >
    <UserControl.Resources>
        <!-- the tabs sit flush with the top of the screen, so the tooltip has to hang below them -->
        <Style x:Key="TabTooltipStyle" TargetType="ToolTip" BasedOn="{StaticResource ArenaTooltipStyle}">
            <Setter Property="Placement" Value="Bottom" />
            <!-- the base style centers on the target, which would push the tooltip off the right edge -->
            <Setter Property="HorizontalOffset" Value="0" />
        </Style>

        <Style x:Key="GuidesTabButtonStyle" TargetType="Border">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#141617" />
            <Setter Property="BorderThickness" Value="1,0,0,1" />
            <Setter Property="BorderBrush" Value="#3f4346" />
            <Setter Property="Width" Value="83" />
            <Setter Property="Height" Value="49" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C3135" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaSnapshotButtonStyle" TargetType="Border">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextElement.Foreground" Value="White" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,7,8,7" />
            <Setter Property="BorderBrush" Value="{StaticResource Tier7Purple}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#7636A8" />
                        <GradientStop Offset="1" Color="#661E9F" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#9143D5" />
                                <GradientStop Offset="1" Color="#7E22CE" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel extensions:OverlayExtensions.IsOverlayHitTestVisible="True">
        <!-- the bar hangs off the right edge, so a hidden tab has to give up its space there -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#2C3135">
            <battlegrounds:OverlayButton Command="{Binding ShowMinionsCommand}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GuidesTabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveViewModel, Converter={StaticResource ObjectTypeConverter}}" Value="{x:Type minions:BattlegroundsMinionsViewModel}">
                                <Setter Property="Background" Value="#23272A" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="83"
                      Height="49">
                    <Rectangle Fill="White" Height="23" Width="18.2">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{DynamicResource icon_card}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </battlegrounds:OverlayButton>

            <battlegrounds:OverlayButton Command="{Binding ShowCompsCommand}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GuidesTabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveViewModel, Converter={StaticResource ObjectTypeConverter}}" Value="{x:Type local:BattlegroundsCompsGuidesViewModel}">
                                <Setter Property="Background" Value="#23272A" />
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="83"
                      Height="49">
                    <Rectangle Fill="White" Height="23" Width="31">
                        <Rectangle.OpacityMask>
                            <VisualBrush Visual="{DynamicResource icon_comp}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </battlegrounds:OverlayButton>

            <Border Background="Transparent" ToolTipService.InitialShowDelay="500"
                    Visibility="{Binding HeroesTabVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.ToolTip>
                    <ToolTip
                        Visibility="{Binding HeroesTabEnabled, Converter={StaticResource InverseBoolToVisibility}}"
                        Style="{StaticResource TabTooltipStyle}"
                        Content="{lex:Loc Battlegrounds_GuidesTabs_Heroes_Disabled_Tooltip}" />
                </Border.ToolTip>
                <battlegrounds:OverlayButton Command="{Binding ShowHeroesCommand}" IsEnabled="{Binding HeroesTabEnabled}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GuidesTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveViewModel, Converter={StaticResource ObjectTypeConverter}}" Value="{x:Type heroes:BattlegroundsHeroGuideListViewModel}">
                                    <Setter Property="Background" Value="#23272A" />
                                    <Setter Property="BorderThickness" Value="1,0,0,0" />
                                </DataTrigger>
                                <!-- after the hover trigger, so it wins while the tab is disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#141617" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Width="83"
                          Height="49">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HeroesTabEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Fill="White">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="27" />
                                    <Setter Property="Width" Value="24" />
                                    <Setter Property="Margin" Value="2.5,3.7,0,0" />
                                    <Setter Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Visual="{DynamicResource icon_hero_and_quest}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuests}" Value="False">
                                            <Setter Property="Height" Value="23" />
                                            <Setter Property="Width" Value="21" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <VisualBrush Visual="{DynamicResource icon_hero}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </battlegrounds:OverlayButton>
            </Border>
        </StackPanel>
        <!-- the fade would keep reserving space, so opening a tab collapses the panel through this wrapper instead -->
        <Grid Visibility="{Binding MetaSnapshotHasRoom, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#23272A"
                    BorderBrush="#3f4346"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="0,5,0,0"
                    Padding="10"
                    Visibility="Collapsed"
                    anim:FadeAnimation.Visibility="{Binding MetaSnapshotVisible, Converter={StaticResource BoolToVisibility}}"
                    anim:FadeAnimation.Direction="Down" anim:FadeAnimation.Distance="20" anim:FadeAnimation.Duration="0:0:0.2"
                >
                <StackPanel>
                    <TextBlock Text="{lex:Loc Battlegrounds_GuidesTabs_MetaSnapshot_Description}"
                               Foreground="#9CA3A8"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                        />
                    <battlegrounds:OverlayButton Command="{Binding MetaSnapshotCommand}"
                            Style="{StaticResource MetaSnapshotButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Fill="White" Width="13.5" Height="17" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Visual="{DynamicResource appbar_hsreplay}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="{lex:Loc Battlegrounds_GuidesTabs_MetaSnapshot_Button}" VerticalAlignment="Center" Margin="0,-1,0,1" />
                        </StackPanel>
                    </battlegrounds:OverlayButton>
                </StackPanel>
            </Border>
        </Grid>
        <Border Visibility="{Binding ActiveViewModel, Converter={StaticResource NullableToVisibility}}"
                x:Name="TabsContent"
            >
            <ContentControl x:Name="ActiveContent" Content="{Binding ActiveViewModel}">
                <ContentControl.Resources>
                    <minions:BattlegroundsMinions x:Key="Minions" />
                    <comps:CompGuideList x:Key="Comps" />
                    <StackPanel x:Key="Heroes">
                        <heroes:HeroGuide />
                        <quests:QuestGuide DataContext="{Binding Source={x:Static hearthstoneDeckTracker:Core.Overlay}, Path=BattlegroundsQuestGuideListViewModel}" />
                    </StackPanel>

                    <DataTemplate DataType="{x:Type minions:BattlegroundsMinionsViewModel}">
                        <ContentControl Content="{StaticResource Minions}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:BattlegroundsCompsGuidesViewModel}">
                        <ContentControl Content="{StaticResource Comps}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type heroes:BattlegroundsHeroGuideListViewModel}">
                        <ContentControl Content="{StaticResource Heroes}"/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </StackPanel>
</UserControl>
