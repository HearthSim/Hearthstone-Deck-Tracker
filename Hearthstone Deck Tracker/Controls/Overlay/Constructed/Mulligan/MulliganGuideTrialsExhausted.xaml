<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.Overlay.Constructed.Mulligan.MulliganGuideTrialsExhausted"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.Constructed.Mulligan"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             xmlns:ext="clr-namespace:Hearthstone_Deck_Tracker.Utility.Extensions"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="HearthstoneDeckTracker"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d">
    <d:UserControl.DataContext>
        <local:MulliganGuideTrialsExhaustedViewModel TrialTimeRemaining="3d 4h" />
    </d:UserControl.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../OverlayResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style.Setters>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="380" Background="{StaticResource Tier7Black}" BorderBrush="{StaticResource HSReplayNetBlue}"
            BorderThickness="1" CornerRadius="5" VerticalAlignment="Top" HorizontalAlignment="Left"
            ext:OverlayExtensions.IsOverlayHitTestVisible="True">
        <StackPanel>
            <!-- Header -->
            <Border Background="{StaticResource HSReplayNetBlue}" Padding="8 5" Margin="-1 -1 -1 0" CornerRadius="4 4 0 0">
                <DockPanel>
                    <Image Height="12" Width="19" Source="{StaticResource HsReplayIconWhite}"
                           RenderOptions.BitmapScalingMode="Fant" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right" Padding="4 3" Margin="0 -3 -3 -3" CornerRadius="3" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" />
                        </Border.InputBindings>
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{lex:Loc ConstructedTrialsExhausted_Header}" Margin="12 0" VerticalAlignment="Center" TextAlignment="Left"/>
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel Margin="24 20">
                <TextBlock Text="{lex:Loc ConstructedTrialsExhausted_Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource HSReplayNetPremiumGold}"/>
                <TextBlock Text="{lex:Loc ConstructedTrialsExhausted_Description}" Margin="0 12 0 0"/>
                <TextBlock Margin="0 12 0 0" Visibility="{Binding ResetTimeVisibility}">
                    <Run Text="{lex:Loc BattlegroundsPreLobby_TrialsResetsIn}"/>
                    <Bold><Run Text="{Binding TrialTimeRemaining}"/></Bold>
                </TextBlock>
                <Button Cursor="Hand" Height="30" Style="{StaticResource SubscribeButton}" Margin="0 20 0 0"
                        Command="{Binding SubscribeNowCommand}">
                    <TextBlock Text="{lex:Loc ArenaPreDraft_Panel_SubscribeNow}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
