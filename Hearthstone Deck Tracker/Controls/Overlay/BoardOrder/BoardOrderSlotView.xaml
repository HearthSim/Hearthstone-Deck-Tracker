<UserControl x:Class="Hearthstone_Deck_Tracker.Controls.Overlay.BoardOrder.BoardOrderSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:boardOrder="clr-namespace:Hearthstone_Deck_Tracker.Controls.Overlay.BoardOrder"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance boardOrder:BoardOrderSlotViewModel}">
    <Grid Width="{Binding Width}" Height="{Binding Height}" Margin="{Binding Margin}"
          Visibility="{Binding SlotVisibility}">
        <Border Visibility="{Binding LabelVisibility}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="{Binding BadgeMargin}"
                MinWidth="{Binding BadgeSize}"
                Height="{Binding BadgeSize}"
                CornerRadius="1000"
                Background="Black"
                BorderBrush="White"
                BorderThickness="1">
            <TextBlock Text="{Binding Label}"
                       Margin="4,0,4,1"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="{Binding FontSize}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
