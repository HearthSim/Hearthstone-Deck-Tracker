<controls:MetroWindow x:Class="Hearthstone_Deck_Tracker.Windows.BattlegroundsMechanicWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:lex="http://wpflocalizeextension.codeplex.com"
                      lex:LocalizeDictionary.DesignCulture="en"
                      lex:ResxLocalizationProvider.DefaultAssembly="HearthstoneDeckTracker"
                      lex:ResxLocalizationProvider.DefaultDictionary="Strings"
                      Title="{lex:Loc BattlegroundsMechanicWindow_Title}" Height="430" Width="300"
                      Background="{Binding BackgroundColor}"
                      Icon="{StaticResource AppIcon}"
                      Closing="BattlegroundsMechanicWindow_OnClosing"
                      IsVisibleChanged="BattlegroundsMechanicWindow_OnIsVisibleChanged"
                      Activated="BattlegroundsMechanicWindow_OnActivated" Deactivated="BattlegroundsMechanicWindow_OnDeactivated">
    <controls:MetroWindow.IconTemplate>
        <DataTemplate>
            <Rectangle Margin="2" Opacity="0.7">
                <Rectangle.Fill>
                    <VisualBrush Visual="{StaticResource hdticon}" />
                </Rectangle.Fill>
            </Rectangle>
        </DataTemplate>
    </controls:MetroWindow.IconTemplate>
    <Image Source="{Binding CardAsset.Asset}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
</controls:MetroWindow>
