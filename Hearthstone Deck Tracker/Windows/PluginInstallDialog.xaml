<dialogs:CustomDialog x:Class="Hearthstone_Deck_Tracker.Windows.PluginInstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="HearthstoneDeckTracker"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="600">
    <StackPanel>
        <TextBlock Name="TextBlockDesc" Text="{lex:Loc Options_Tracker_Plugins_Dialog_Install_Desc}" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,0"/>
        <TextBlock Name="TextBlockDescAdmin" Text="{lex:Loc Options_Tracker_Plugins_Dialog_Install_Desc_Admin}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,0"/>
        <CheckBox Name="CheckBoxAcknowledge" Visibility="Collapsed" Margin="0,15,0,0"
                  Checked="CheckBoxAcknowledge_OnChanged" Unchecked="CheckBoxAcknowledge_OnChanged">
            <TextBlock Text="{lex:Loc Options_Tracker_Plugins_Dialog_Install_Admin_Acknowledge}" TextWrapping="Wrap"/>
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,15">
            <Button Name="BtnInstall" Style="{DynamicResource AccentedSquareButtonStyle}" Height="35" MinWidth="80" Padding="10,0" Click="BtnInstall_OnClick">
                <TextBlock Text="{lex:Loc Options_Tracker_Plugins_Dialog_Install_Button_Install}"/>
            </Button>
            <Button Name="BtnCancel" Content="{lex:Loc Options_Tracker_Plugins_Dialog_Install_Button_Cancel}"
                    Height="35" MinWidth="80" Padding="10,0" Margin="5,0,0,0" Click="BtnCancel_OnClick"/>
        </StackPanel>
    </StackPanel>
</dialogs:CustomDialog>
